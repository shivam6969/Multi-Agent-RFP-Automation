# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored: never commit real keys.

# Required for all agents (router, RFP, BU, matching, pricing)
OPENROUTER_API_KEY=

# Required for proposal PDF generation (report agent)
GEMINI_API_KEY=

# ── Backup APIs (optional) ─────────────────────────────────────────────────
# Used automatically when a call to the primary fails (outage, rate limit,
# bad key, timeout). Any OpenAI-compatible API works as the chat backup:
#   OpenRouter (second key):  LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#   Groq:                     LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
#   OpenAI:                   LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=          # model name at that provider; empty = same as LLM_MODEL
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#
# Proposal text: Gemini -> backup Gemini key/model -> the OpenRouter chain above
# GEMINI_FALLBACK_API_KEY=
# GEMINI_FALLBACK_MODEL=       # empty = same as GEMINI_MODEL
# GEMINI_FALLBACK_TO_OPENROUTER=true
#
# LLM_TIMEOUT_SECONDS=90       # per request
# LLM_RETRIES_PER_ENDPOINT=1   # retries on timeouts / 429 / 5xx before moving on

# Optional overrides
# LLM_MODEL=meta-llama/llama-4-scout
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# RFP_PDF_PATH=data/samples/sample_rfp.pdf
